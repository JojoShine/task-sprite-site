# Private publisher environment. Never commit real credentials.
OSS_REGION=cn-hangzhou
OSS_BUCKET=your-bucket
OSS_ENDPOINT=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret

# Use private archives and mirror verified files on the existing website.
OSS_PUBLIC_READ=false
DOWNLOAD_ORIGIN=https://tbtparent.me/
